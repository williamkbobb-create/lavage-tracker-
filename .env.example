# Supabase browser-safe configuration only.
# Set these values only after the new project has been approved and provisioned.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: business slug used for tenant-scoped customer tracking after migration approval.
VITE_BUSINESS_SLUG=

# Enable only after the reviewed tenant migration is tested and applied.
VITE_TENANT_WORKSPACES_ENABLED=false
